# Neon Postgres (Vercel Marketplace). Required for orders on Vercel / production.
# Locally: vercel env pull --yes after connecting Neon, or paste DATABASE_URL here.
DATABASE_URL=

# Play address shown on the site.
NEXT_PUBLIC_SERVER_ADDRESS=nebulacraft.atbp.fun

# Public host used for the online-player count. Queried through mcsrvstat.us.
MC_STATUS_HOST=nebulacraft.atbp.fun

# Optional. Shown in the footer only when it starts with https://
NEXT_PUBLIC_DISCORD_URL=

# Optional. Shown on the support page.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Shared with plugins/NebulaStore/config.yml. At least 24 characters.
STORE_PLUGIN_SECRET=

# USD → PHP conversion for QR Ph / PayPal PHP (catalog prices are USD cents).
PHP_PER_USD=58

# PayMongo — QR Ph (GCash / Maya / banks via InstaPay). Required for QR checkout.
PAYMONGO_SECRET_KEY=
# Webhook signing secret from PayMongo Developers → Webhooks.
PAYMONGO_WEBHOOK_SECRET=

# PayPal REST app credentials. sandbox or live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional Stripe. Only if you have a Stripe account in a supported country.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used when the browser does not send an Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local only. Ignored when NODE_ENV=production.
# Marks the order paid immediately so you can test the plugin without a gateway.
STORE_DEV_CHECKOUT=false
